rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return signedIn() ? request.auth.token.role : null;
    }
    function hasAnyRole(roles) {
      return signedIn() && role() in roles;
    }
    function isDataController() {
      return hasAnyRole(['dataController']);
    }
    function canReadClinicalRecords() {
      return hasAnyRole(['dataController', 'doctor', 'nurse', 'midwife']);
    }
    function canManageAppointments() {
      return hasAnyRole(['dataController', 'adminClerk', 'doctor', 'nurse', 'midwife']);
    }

    // All writes go through validated Cloud Functions using the Admin SDK.
    // Client-side writes are denied, including for signed-in staff.
    match /patients/{patientId} {
      allow read: if canReadClinicalRecords();
      allow create, update, delete: if false;
    }
    match /_privatePatientIdentityKeys/{keyId} {
      allow read, write: if false;
    }
    match /_systemCounters/{counterId} {
      allow read, write: if false;
    }
    match /appointments/{appointmentId} {
      allow read: if canManageAppointments();
      allow create, update, delete: if false;
    }
    match /inventoryItems/{medicineId} {
      allow read: if hasAnyRole(['dataController', 'adminClerk', 'nurse', 'doctor', 'midwife', 'bhw']);
      allow write: if false;
      match /batches/{batchId} {
        allow read: if hasAnyRole(['dataController', 'adminClerk', 'nurse']);
        allow write: if false;
      }
    }
    match /auditLogs/{auditId} {
      allow read: if isDataController();
      allow write: if false;
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isDataController());
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
